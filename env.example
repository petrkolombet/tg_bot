# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id

# Gemini (OpenAI-совместимый прокси, основной «мозг»)
GEMINI_PROXY_URL=http://127.0.0.1:4984
GEMINI_PROXY_KEY=sk-gemini
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek (саммари, выжимки тулов, веб-поиск)
DEEPSEEK_PROXY_URL=http://127.0.0.1:9655
DEEPSEEK_PROXY_KEY=sk-freedeepseek
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek (рефлексия, фоновые мысли)
REFLECTION_PROXY_URL=http://127.0.0.1:9655
REFLECTION_PROXY_KEY=sk-freedeepseek
REFLECTION_MODEL=deepseek-reasoner
REFLECTION_TEMPERATURE=0.7

# Почта Mail.ru (email-тул)
EMAIL_USER=your_email_login
EMAIL_PASS=your_email_password

# Groq (транскрипция голосовых; ключи через запятую)
GROQ_KEYS=key1,key2